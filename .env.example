# Copy to .env and fill in. .env never enters git. Every setting is read by
# src/raredx/config.py; the prefix is RAREDX_, except the provider's own key name.

# The model API key (DeepSeek). Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# The HTTP service (`raredx serve`). When this is set, every /v1 request must
# send it as the X-API-Key header. Leave empty on your own machine.
# RAREDX_SERVICE_API_KEY=

# Optional overrides.
# RAREDX_LLM_MODEL=deepseek-flash
# RAREDX_LLM_BASE_URL=https://api.deepseek.com
# RAREDX_DATA_DIR=data
# RAREDX_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# RAREDX_SERVICE_MAX_CONCURRENT=4       # requests answered at once; more get 503
# RAREDX_SERVICE_DEADLINE_SECONDS=60    # then the no-model ranking answers
# RAREDX_SERVICE_PATIENT_BANK=evaluated # or "all": every published patient (unmeasured)
