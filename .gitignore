# Secrets. Copy .env.example to .env and fill it in; .env itself never enters git.
.env
*.key

# Python / uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data and run outputs never enter the repo; fetch scripts recreate them.
/data/
/runs/

# MLflow's local store: run records and their files. Never in git.
/mlflow.db
/mlruns/

# Third-party checkouts (DeepRare, ...) are fetched, not vendored.
third_party/

# OS / editor
.DS_Store
.vscode/
.idea/
